# Private demo: JSON file storage, not a production database.
CARFAM_DATA_FILE=.data/store.json
CARFAM_READ_ONLY=0
CARFAM_UPLOAD_DIR=.data/photo-uploads
# Runtime optimizer remains off unless explicitly enabled.
CARFAM_IMAGE_OPTIMIZER=off
NEXT_TELEMETRY_DISABLED=1
# Optional, server-only. Both are required to activate live AI extraction.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
# Single-process daily token reservation cap; restarts reset this demo counter.
CARFAM_AI_DAILY_TOKEN_CAP=50000
